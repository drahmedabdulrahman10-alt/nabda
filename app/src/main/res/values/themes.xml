<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window background matches the app background so start-up shows no white flash. -->
    <style name="Theme.Nabda" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- One task line in the home-screen widget. -->
    <style name="WidgetTask">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:visibility">gone</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
</resources>
